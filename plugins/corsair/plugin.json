{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "corsair",
  "version": "0.1.2",
  "description": "Use your connected apps from your agent: read and act on them, search synced data and set up automations.",
  "author": {
    "name": "Corsair",
    "email": "primary@corsair.dev",
    "url": "https://corsair.dev"
  },
  "homepage": "https://corsair.dev",
  "repository": "https://github.com/corsairdev/agent-plugins",
  "license": "Apache-2.0",
  "keywords": ["corsair", "integrations", "automation", "mcp"],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/corsair-connect-apps/SKILL.md",
      "interface": {
        "displayName": "Corsair",
        "shortDescription": "Use your connected apps and automate across them",
        "developerName": "Corsair",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://corsair.dev",
        "privacyPolicyURL": "https://corsair.dev/privacy-policy",
        "termsOfServiceURL": "https://corsair.dev/terms-of-service",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "defaultPrompt": [
          "Which apps do I have connected?",
          "When a Linear issue is marked Done, post it in #ships on Slack."
        ]
      }
    }
  }
}
